\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Representación de los vectores velocidad de propagación ($\text  {V}_{\text  {Prop}}$) y de expansión ($\text  {V}_{\text  {Exp}}$) en puntos cualquiera de la CME. El vector $\text  {V}_{\text  {Exp}}$ presenta direcciones hacia fuera de la CME en diferentes puntos, mientras que el vector $\text  {V}_{\text  {Prop}}$ tiene una dirección hacia la derecha en todo punto de la CME. Además, el vector resultante de la superposición del vector propagación y expansión, se muestra como $V_{CME}$ y cambia de dirección según el punto dentro de la CME.}}{7}{figure.caption.2}\protected@file@percent }
\newlabel{vectoresCME}{{2}{7}{Representación de los vectores velocidad de propagación ($\text {V}_{\text {Prop}}$) y de expansión ($\text {V}_{\text {Exp}}$) en puntos cualquiera de la CME. El vector $\text {V}_{\text {Exp}}$ presenta direcciones hacia fuera de la CME en diferentes puntos, mientras que el vector $\text {V}_{\text {Prop}}$ tiene una dirección hacia la derecha en todo punto de la CME. Además, el vector resultante de la superposición del vector propagación y expansión, se muestra como $V_{CME}$ y cambia de dirección según el punto dentro de la CME}{figure.caption.2}{}}
