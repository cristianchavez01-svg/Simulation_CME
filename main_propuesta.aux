\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Perfiles de aceleración y vecidad en función del tiempo para las dos CMEs generadas, en donde las curva a$_1$ (azul) y a$_2$ (roja) representan las aceleraciones de la CME1 y CME2, respectivamente. Las curvas v$_1$ (azul claro) y v$_2$ (salmón) representan sus velocidades. Se indican los valores máximos de aceleración a$_1$ y a$_2$, delimitando las etapas de aceleración y propagación de las CMEs.}}{10}{figure.caption.5}\protected@file@percent }
\newlabel{Aceleración_Velocidad}{{4}{10}{Perfiles de aceleración y vecidad en función del tiempo para las dos CMEs generadas, en donde las curva a$_1$ (azul) y a$_2$ (roja) representan las aceleraciones de la CME1 y CME2, respectivamente. Las curvas v$_1$ (azul claro) y v$_2$ (salmón) representan sus velocidades. Se indican los valores máximos de aceleración a$_1$ y a$_2$, delimitando las etapas de aceleración y propagación de las CMEs}{figure.caption.5}{}}
\abx@aux@page{76}{10}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Perfil de altura, velocidad, aceleración de la CME y el flujo de rayos X del 21 de abril de 2002 a las 00:43 UT, en función del tiempo. Los círculos rellenos son valores derivados de la gráfica de altura vs tiempo, los demás simbolos señalan las observaciones del TRACE, UVCS y del LASCO. La linea continua indica la curva con el mejor ajuste para los datos \blx@tocontentsinit {0}\parencite []{gallagher-2003}.}}{11}{figure.caption.6}\protected@file@percent }
\newlabel{ejemploperfilaceleracion}{{5}{11}{Perfil de altura, velocidad, aceleración de la CME y el flujo de rayos X del 21 de abril de 2002 a las 00:43 UT, en función del tiempo. Los círculos rellenos son valores derivados de la gráfica de altura vs tiempo, los demás simbolos señalan las observaciones del TRACE, UVCS y del LASCO. La linea continua indica la curva con el mejor ajuste para los datos \parencite []{gallagher-2003}}{figure.caption.6}{}}
